# pre-push hook
# 在推送前运行快速本地检查，确保代码质量
# 依赖数据库的集成测试由 GitHub Actions CI 负责
set -e

echo "🔍 Running pre-push checks..."
echo ""

run_docker_check() {
  local service="$1"
  local command="$2"
  CODEX_DOCKER_SERVICE="$service" CODEX_DOCKER_WORKDIR=/app ./scripts/codex-docker-run.sh "$command"
}

# 1. 生成 Prisma Client（TypeScript 类型检查需要）
echo "📦 Generating Prisma Client..."
run_docker_check server 'pnpm --filter @stss/server db:generate'

# 2. 构建 shared 包
echo "📦 Building shared package..."
run_docker_check server 'pnpm --filter @stss/shared build'

# 3. Lint 检查
echo "🔍 Running lint..."
run_docker_check server 'pnpm lint'

# 4. TypeScript 类型检查
echo "🔍 Running type check..."
run_docker_check server 'pnpm --filter @stss/shared build && pnpm --filter @stss/server typecheck'
run_docker_check web 'pnpm --filter @stss/web typecheck'

# 5. 前端 Vitest 测试
echo "🧪 Running frontend tests..."
run_docker_check web 'pnpm --filter @stss/web test:run'

# 6. 后端单元测试（集成测试需要数据库，交给 CI）
echo "🧪 Running backend unit tests..."
run_docker_check server 'pnpm --filter @stss/server test:unit'

# 7. Prisma 验证和格式检查
echo "🔍 Validating Prisma schema..."
run_docker_check server 'pnpm --filter @stss/server exec prisma validate'

echo "🔍 Checking Prisma schema format..."
run_docker_check server 'pnpm --filter @stss/server exec prisma format --check'

echo ""
echo "✅ All checks passed! Pushing..."
